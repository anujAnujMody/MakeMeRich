# Root .env — read by `docker-compose.yml`.
# Copy this file to `.env` (same directory) and fill in the values below.
# `.env` is gitignored — never commit it.
#
# This file only documents what docker-compose actually substitutes into the
# containers. It does NOT duplicate OpenAlgo's own ~50-key configuration
# (broker credentials, rate limits, logging, etc.) — those live directly in
# your real `.env` because the `openalgo` service loads the whole file via
# `env_file: .env`. If you need OpenAlgo's full key list, check OpenAlgo's
# own documentation/sample env rather than this file, which would only drift
# out of sync if it tried to duplicate that list.

# --- Required: the engine container's connection to OpenAlgo ---
# Get this from OpenAlgo's web UI once it's running: http://localhost:5000 -> API Key page.
# Has NO default — the engine container's OpenAlgo API key is blank until this is set.
OPENALGO_API_KEY=

# --- Optional overrides (all have sane defaults baked into docker-compose.yml) ---
# Uncomment only if you need to change one.
# TE_ENV=dev
# TE_DATABASE_URL=sqlite:////app/data/dev.db
# TE_BAR_STORE_PATH=/app/data/bars
# TE_OPENALGO_HOST=http://openalgo:5000
# OpenAlgo's WebSocket endpoint — a SEPARATE setting, never derived from
# TE_OPENALGO_HOST (that host already has a port, and the two endpoints can
# differ entirely behind a proxy).
# TE_OPENALGO_WS_HOST=ws://openalgo:8765
# TE_CORS_ORIGINS=["http://localhost:8080"]

# --- OpenAlgo's own config ---
# The `openalgo` service also needs BROKER, BROKER_API_KEY, TOTP_SECRET,
# CLIENT_ID, PASSWORD, PIN, APP_KEY, API_KEY_PEPPER, FERNET_SALT, and a large
# number of other OpenAlgo-internal settings (rate limits, session, logging,
# database paths, etc.). Add these to your real `.env` alongside the keys
# above — OpenAlgo reads the whole file directly.
