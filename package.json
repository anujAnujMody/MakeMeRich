{
  "name": "algo-trading",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "dev": "yarn workspace dashboard dev",
    "dev:real": "yarn workspace dashboard dev:real",
    "dev:engine": "cd engine && .venv\\Scripts\\dotenv run -- .venv\\Scripts\\uvicorn te.api.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:all": "concurrently -n openalgo,engine,dashboard -c yellow,blue,green \"docker compose up openalgo\" \"yarn dev:engine\" \"yarn dev:real\"",
    "build": "yarn workspace dashboard build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
